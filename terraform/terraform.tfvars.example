# ============================================================
# Copy to terraform.tfvars and fill in your values
# terraform apply -var-file=terraform.tfvars
# ============================================================

aws_region   = "us-east-1"
project_name = "hospital"
environment  = "prod"


# ---- EC2 ----
ec2_instance_type = "t3.micro"
ssh_key_name      = "hospital-key"   # create this key pair in AWS first

# ---- SES SMTP (from SES > SMTP Settings > Create My SMTP Credentials) ----
ses_smtp_username = "gr0735618@gmail.com"
ses_smtp_password  = "kegtdqfktjxvtmzl"
ses_from_email     = "gr0735618@gmail.com"   # verify this address in SES

# ---- Gmail SMTP for OTP mail (recommended — OTP arrives by email) ----
# The Lambda sends the OTP through Gmail instead of SES when these are set.
# Needs a Gmail App Password: Google Account > Security > 2-Step Verification
# (ON) > App passwords > app "Mail" > Generate. The 16-digit code goes below.
# Put the real values in YOUR OWN terraform.tfvars and run terraform apply —
# never commit the App Password to the repo.
# smtp_host       = "smtp.gmail.com"
# smtp_port       = "587"
# smtp_username   = "gr0735618@gmail.com"
# smtp_password   = "<16-digit App Password for gr0735618@gmail.com>"
# smtp_from_email = "gr0735618@gmail.com"
